# Copy to .env.local and fill in from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Vercel only: any long random string. Vercel sends it to /api/daily so only its cron can call it.
CRON_SECRET=

# Bill reminders (v1.0.4). Generate a key pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Supabase → Project Settings → API Keys → secret key. Server only: lets the daily cron read every user's bills.
SUPABASE_SERVICE_ROLE_KEY=
